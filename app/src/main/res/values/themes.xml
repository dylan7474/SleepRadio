<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark, no action bar. Compose paints the real UI; this only governs the
         cold-start window background. Below API 31, windowBackground alone is
         what's shown at cold start — the platform splash-screen attributes
         (API 31+) live in values-v31/themes.xml. -->
    <style name="Theme.SleepRadio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Platform dialogs (e.g. the quiet-hours time picker) take their accent and
             background from here, not from the Compose Material scheme. -->
        <item name="android:colorAccent">@color/studio_accent</item>
        <item name="android:colorBackgroundFloating">@color/studio_dialog</item>
    </style>
</resources>
